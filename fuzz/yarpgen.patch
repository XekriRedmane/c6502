+// --max-loop-iters and --max-stmts cap what the policy picked.
+void GenPolicy::applyUserLimits() {
+    Options &options = Options::getInstance();
+    if (options.getMaxLoopIters() != 0) {
+        iter_end_limit_max =
+            std::min(iter_end_limit_max, options.getMaxLoopIters());
+        iters_end_limit_min = std::min(iters_end_limit_min, iter_end_limit_max);
+    }
+    if (options.getMaxStmts() != 0)
+        stmt_num_lim = std::min(stmt_num_lim, options.getMaxStmts());
+}
